<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org" 
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.openshift</groupId>
    <artifactId>eap-war-puller</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <!-- Note that the RH Maven version is 3.6.1.  Version 3.11.0 needs 3.6.3 min -->
                <version>3.6.1</version> 
                <executions>
                    <execution>
                        <id>copy-war-files</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- First WAR File -->
                                <artifactItem>
                                    <groupId>org.jboss.eap.quickstarts</groupId>
                                    <artifactId>helloworld-html5</artifactId>
                                    <version>7.4.0.GA</version>
                                    <type>war</type>
                                    <destFileName>helloworld-html5.war</destFileName>
                                </artifactItem>
                                <!-- Second WAR File -->
                                <artifactItem>
                                    <groupId>org.jboss.eap.quickstarts</groupId>
                                    <artifactId>helloworld-rs</artifactId>
                                    <version>7.4.0.GA</version>
                                    <type>war</type>
                                    <destFileName>helloworld-jms.war</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <!-- This target folder is the S2I default drop-zone -->
                            <outputDirectory>${project.basedir}/deployments</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>internal-nexus</id>
            <url>10.217.4.130:8081</url> <!-- Using ClusterIP for test-->
            <!-- <url>https://nexus3-multi-war-helm-mvn.apps-crc.testing/repository/maven-public</url> -->
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

</project>
